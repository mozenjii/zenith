{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mohibahmad",
  "compatibility_date": "2026-09-05",

  /*
    Cloudflare Pages, not a Worker.

    Both can host a static export, but the URL shape differs and that is the
    whole reason for the choice: Pages serves <project>.pages.dev, while a
    Worker serves <worker>.<account-subdomain>.workers.dev. The account
    subdomain is set once, cannot be changed through the API afterwards, and on
    this account had been auto-derived from the package.json name — which
    produced mohib-ahmad.personal-profile-signal-map.workers.dev, 51 characters
    of it, with no way back. Pages has no middle label to get wrong.

    There is no functional downside here. `_headers` and `_redirects` are Pages
    features that Workers static assets later adopted, so both files behave
    identically, and epoches.co is already deployed this way on the same
    account.

    Deploy with `npm run deploy`, which builds first. `pages_build_output_dir`
    is what lets `wrangler pages deploy` find the export without arguments.
  */
  "pages_build_output_dir": "./out"
}
